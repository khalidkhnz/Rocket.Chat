# Copy to deploy/dev/.env and edit. Loaded by `yarn dev:tt`.
MONGO_URL="mongodb://localhost:27017/technotribes?replicaSet=rs0&directConnection=true"
MONGO_OPLOG_URL="mongodb://localhost:27017/local?replicaSet=rs0&directConnection=true"
ROOT_URL=http://localhost:3000
PORT=3000

# First-boot admin (created only if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASS=change-me-now
ADMIN_EMAIL=admin@technotribes.ai
ADMIN_NAME="TechnoTribes Admin"

# Skip the setup wizard + cloud registration
OVERWRITE_SETTING_Show_Setup_Wizard=completed
OVERWRITE_SETTING_Register_Server=false
OVERWRITE_SETTING_Organization_Name=TechnoTribes
OVERWRITE_SETTING_Site_Name=TechnoTribes
