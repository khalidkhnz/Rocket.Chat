# Copy to deploy/prod/.env. Never commit .env.

# Public hostname. Caddy issues a Let's Encrypt cert for it (ports 80/443 must be reachable).
# Use "localhost" for a local smoke test (Caddy uses an internal self-signed cert).
DOMAIN=chat.technotribes.ai
ROOT_URL=https://chat.technotribes.ai

# Image (set by build.sh; override to pin a version)
IMAGE=ghcr.io/khalidkhnz/technotribes-chat
TAG=latest

# WiredTiger cache for Mongo in GB (~50% of the RAM you give Mongo)
MONGO_CACHE_GB=1

# First-boot admin (only used while no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASS=change-me-before-first-boot
ADMIN_EMAIL=admin@technotribes.ai
ADMIN_NAME="TechnoTribes Admin"

# Skip setup wizard and Rocket.Chat cloud registration
OVERWRITE_SETTING_Show_Setup_Wizard=completed
OVERWRITE_SETTING_Register_Server=false
OVERWRITE_SETTING_Organization_Name=TechnoTribes
OVERWRITE_SETTING_Site_Name=TechnoTribes

# Outbound email (SMTP URL). Leave empty to configure later in Admin > Email.
# OVERWRITE_SETTING_SMTP_Host=smtp.example.com
# OVERWRITE_SETTING_SMTP_Port=587
# OVERWRITE_SETTING_SMTP_Username=
# OVERWRITE_SETTING_SMTP_Password=
# OVERWRITE_SETTING_From_Email=chat@technotribes.ai

# File uploads to S3 instead of the local volume (recommended above ~50 users)
# OVERWRITE_SETTING_FileUpload_Storage_Type=AmazonS3
# OVERWRITE_SETTING_FileUpload_S3_Bucket=
# OVERWRITE_SETTING_FileUpload_S3_Region=ap-south-1
# OVERWRITE_SETTING_FileUpload_S3_AWSAccessKeyId=
# OVERWRITE_SETTING_FileUpload_S3_AWSSecretAccessKey=
# OVERWRITE_SETTING_FileUpload_S3_BucketURL=

# Memory guard: restart when heap passes this % of the container limit
HEAP_USAGE_PERCENT=90
